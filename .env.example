# BTC Map Admin - Environment Configuration

# Flask Secret Key (use a strong random key in production)
SECRET_KEY=your-secret-key-here-change-in-production

# Token Encryption Key (base64-encoded Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_CIPHER_KEY=your-fernet-key-here

# API Base URL (optional, defaults to https://api.btcmap.org).
# Must be absolute and identical to the API's own BTCMAP_API_BASE_URL: NIP-98
# events sign this exact origin. For local API dev use http://127.0.0.1:8000.
# API_BASE_URL=https://api.btcmap.org

